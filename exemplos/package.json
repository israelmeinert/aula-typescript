{
  "name": "pokelab-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.frontend.json",
    "build:api": "tsc -p tsconfig.backend.json",
    "dev:api": "npm run build:api && node --watch dist/backend/server.js",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "build": "npm run typecheck && npm run build:api && npm run build:web",
    "test": "tsc -p tsconfig.tests.json && node --test dist-tests/tests/runtime.test.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
